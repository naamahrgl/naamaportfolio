---
// Renders one project as a tiny "browser window" preview.
// If `image` is given, it's used as a static screenshot.
// Otherwise the live site is embedded and scaled down to
// look like a real thumbnail of the actual page.

interface Props {
  title: string;
  url: string;
  description?: string;
  image?: string;
  zoom?: number;
    tag?: string;

}

const { title, url, description, tag, image, zoom = 1 } = Astro.props;

let host = url;
try {
  host = new URL(url).hostname.replace(/^www\./, '');
} catch {
  // leave `host` as-is if url isn't a full absolute URL
}
---

<a class="card" href={url} target="_blank" rel="noopener noreferrer">
  <span class="frame">
    <span class="chrome" aria-hidden="true">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </span>
<span class="preview" style={`--zoom: ${zoom}`}>
        {image ? (
        <img src={image} alt="" loading="lazy" />
      ) : (
        <iframe src={url} title="" tabindex="-1" aria-hidden="true" loading="lazy"></iframe>
      )}
    </span>
  </span>

  <span class="meta">
    <span class="title">{title}</span>
    {tag && <span class="tag">{tag}</span>}
    {description && <span class="desc">{description}</span>}
    <span class="host">{host}</span>
  </span>
</a>

<style>
  .card {
    display: block;
    color: inherit;
  }
  .tag {
    display: block;
    margin-top: 0.15rem;
    color: var(--accent);
    font-size: 0.82rem;
  }
  .frame {
    display: block;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .chrome {
    display: flex;
    gap: 6px;
    padding: 9px 10px;
    background: var(--paper-raised);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }

  .preview {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #fff;
  }

.preview iframe {
  position: absolute;
  top: 0;
  left: 50%;
  width: 400cqw;
  height: 400cqh;
  transform: translateX(-50%) scale(calc(0.25 * var(--zoom, 1)));
  transform-origin: top center;
  border: 0;
  pointer-events: none;
  transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
}
  .preview img {
    position: absolute;
    top: 0;
    left: 0;
    width: 400%;
    height: 400%;
    transform: scale(0.25);
    transform-origin: top left;
    border: 0;
    pointer-events: none;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: none;
  }

  .card:hover .frame {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -18px rgba(21, 26, 23, 0.35);
  }

.card:hover .preview iframe {
  transform: translateX(-50%) scale(calc(0.27 * var(--zoom, 1))) translateY(-6%);
}

  .card:hover .preview img {
    transform: scale(1.04);
  }

  .meta {
    display: block;
    margin-top: 0.85rem;
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    transition: color 0.2s ease;
  }

  .card:hover .title {
    color: var(--accent);
  }

  .desc {
    display: block;
    margin-top: 0.2rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .host {
    display: block;
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }
</style>
